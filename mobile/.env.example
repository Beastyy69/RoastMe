# URL of the FastAPI backend that the app calls (no trailing slash).
# Android emulator -> http://10.0.2.2:8000
# Physical phone on the same Wi-Fi -> http://YOUR-PC-LAN-IP:8000  (e.g. http://192.168.1.20:8000)
# Production / APK -> your deployed HTTPS URL, e.g. https://roastme-api.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
