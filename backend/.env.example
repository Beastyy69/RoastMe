# Is file ko copy karke .env banao aur values bharo. Asli .env KABHI commit mat karna.

# Kaunsi websites API call kar sakti hain (comma se alag, aakhir me / nahi).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Comedy kaun likhega (comma se kai: pehla fail ho to agla try hota hai):
#   nvidia    = NVIDIA NIM (key: https://build.nvidia.com, nvapi-...)
#   gemini    = Google Gemini (key: https://aistudio.google.com/apikey)
#   none      = sirf local templates (free, internet nahi chahiye)
# Example: AI_PROVIDER=nvidia,gemini
AI_PROVIDER=none
AI_TIMEOUT_SECONDS=25

# NVIDIA NIM
NVIDIA_API_KEY=
# Comma se kai models (pehla fail ho to agla). Khaali = Nemotron 3.5 Super VL, phir Lightning (~1-2 second)
NVIDIA_MODEL=
# Photo roast ke models (photo samajhne wale hi). Khaali = Super VL, phir Nano Omni
NVIDIA_VISION_MODEL=

# Google Gemini
GEMINI_API_KEY=
# flash-lite ~1 second me jawab deta hai; bade models bahut slow ho sakte hain
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional MongoDB Atlas (khaali = history server memory me, restart pe gayab)
MONGODB_URI=
MONGODB_DB=roastme

# Ek IP ek minute me kitni POST requests bhej sakta hai
RATE_LIMIT_PER_MINUTE=30
